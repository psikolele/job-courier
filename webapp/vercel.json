{
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "trailingSlash": false,
  "functions": {
    "api/jobs.js": {
      "maxDuration": 60
    },
    "api/companies.js": {
      "maxDuration": 120
    },
    "api/company-detail.js": {
      "maxDuration": 60
    },
    "api/offerta-ssr.js": {
      "maxDuration": 30
    },
    "api/azienda-ssr.js": {
      "maxDuration": 60
    },
    "api/shell-ssr.js": {
      "maxDuration": 15
    },
    "api/rebuild.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    { "path": "/api/rebuild", "schedule": "0 2 * * *" }
  ],
  "rewrites": [
    { "source": "/offerte", "destination": "/offerte.html" },
    { "source": "/offerta/:id", "destination": "/api/offerta-ssr?id=:id" },
    { "source": "/aziende-che-assumono", "destination": "/aziende-che-assumono.html" },
    { "source": "/azienda/:slug", "destination": "/api/azienda-ssr?slug=:slug" },
    { "source": "/blog", "destination": "/api/shell-ssr?path=/blog" },
    { "source": "/blog/:categoria", "destination": "/api/shell-ssr?path=/blog/:categoria" },
    { "source": "/blog/:categoria/:slug", "destination": "/api/shell-ssr?path=/blog/:categoria/:slug" },
    { "source": "/soluzioni-e-tariffe", "destination": "/soluzioni-e-tariffe.html" },
    { "source": "/come-funziona", "destination": "/come-funziona.html" },
    { "source": "/contatti", "destination": "/contatti.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/condizioni-generali", "destination": "/condizioni-generali.html" },
    { "source": "/cookie-policy", "destination": "/cookie-policy.html" }
  ],
